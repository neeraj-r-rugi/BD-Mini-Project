# Starting Hadoop and Yarn
start-dfs.sh
start-yarn.sh
#Must be run for spark to work.
export JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64/
export PATH=$JAVA_HOME/bin:$PATH

# Because the Iceberg config is opt-in, you must point Spark at it explicitly:
"$SPARK_HOME/bin/spark-shell" --properties-file ~/spark-config/iceberg.conf